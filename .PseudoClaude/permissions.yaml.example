defaultMode: default

permissions:
  allow:
    # Friendly names: Bash, Read, Write, Edit, Glob, Grep.
    # Bash patterns match the normalized full command string.
    - Bash(git status)
    - Bash(go test ./...)
    # File patterns are project-relative. ** crosses directory boundaries.
    - Read
    - Glob(docs/**)
    - Grep(internal/**)
  deny:
    - Bash(git push *)
    - Write(.PseudoClaude/config.yaml)

# Permission files are loaded by priority:
# 1. Session rules from approval prompts, in memory only.
# 2. .PseudoClaude/permissions.local.yaml, for personal permanent approvals.
# 3. .PseudoClaude/permissions.yaml, project-shared rules.
# 4. ~/.PseudoClaude/permissions.yaml, user-wide rules.
#
# defaultMode values: strict, default, acceptEdits, bypassPermissions.
