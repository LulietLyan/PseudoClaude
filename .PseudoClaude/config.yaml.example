providers:
  - name: Claude
    protocol: anthropic
    api_key: sk-ant-...
    model: claude-sonnet-4-5
    thinking: false
    # Optional context window in tokens. Defaults: anthropic=200000, openai=128000.
    context_window: 200000

  - name: OpenAI
    protocol: openai
    api_key: sk-...
    model: gpt-5
    # Optional context window in tokens. Defaults: anthropic=200000, openai=128000.
    context_window: 128000
